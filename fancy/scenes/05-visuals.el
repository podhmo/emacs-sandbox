;;; -*- lexical-binding: t -*-
;;; 05-visuals -- ligatures + indent-bars + page-break-lines demo
(let ((b (get-buffer-create "*visuals*")))
  (with-current-buffer b
    (emacs-lisp-mode)
    (insert ";;; ligatures: ->  ->>  /=  <=  >=  ==  !=\n\n")
    (insert "(defun fancy:demo (x)\n")
    (insert "  (->> x\n")
    (insert "       (mapcar #'1+)\n")
    (insert "       (cl-remove-if #'null)\n")
    (insert "       (--filter (/= it 0))))\n\n")
    (insert "(and (<= a b) (>= c d) (/= e f) (== g h) (!= i j))\n\f\n")
    (insert "(defun deeper ()\n")
    (insert "  (let ((a 1))\n")
    (insert "    (when a\n")
    (insert "      (message \"deep\"))))\n")
    (goto-char (point-min)))
  (switch-to-buffer b)
  (delete-other-windows))
(fancy:shoot (getenv "FANCY_OUT"))
